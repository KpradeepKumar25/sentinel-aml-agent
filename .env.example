# Optional. Intent parsing works fully without this -- the default is a
# local deterministic regex/keyword parser (src/agent/intent_parser.py).
# Setting both of these enables an alternate LLM-based parser (Groq,
# free tier) with automatic fallback to the default parser on any failure
# (missing key, network error, timeout, bad response). See
# src/agent/llm_intent_parser.py and the README's Disclosed AI/Tool Usage
# section for details. Get a free key at console.groq.com.
GROQ_API_KEY=your_groq_api_key_here
USE_LLM_PARSER=false
