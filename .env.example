# Optional. Both features below work fully without this -- the defaults are
# a local deterministic regex/keyword parser (src/agent/intent_parser.py)
# and a plain deterministic SAR template (src/tools/explanation_engine.py).
# Setting GROQ_API_KEY plus either flag enables a Groq-backed enhancement
# with automatic fallback to the default behavior on any failure (missing
# key, network error, timeout, bad response). Get a free key at
# console.groq.com. See the README's Disclosed AI/Tool Usage section.
GROQ_API_KEY=your_groq_api_key_here

# Routes intent parsing through Groq instead of the regex parser.
# See src/agent/llm_intent_parser.py.
USE_LLM_PARSER=false

# Adds one grounded narrative lead sentence to each displayed SAR draft
# (only for the <=50 rows actually shown, never the full flagged set).
# The deterministic "Basis for flag" / "Recommended action" lines are
# never changed by this. See src/agent/llm_sar_narrator.py.
USE_LLM_SAR_NARRATION=false
