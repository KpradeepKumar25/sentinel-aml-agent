# Only needed if you want the optional Groq-backed features enabled on a
# deployed (Streamlit Community Cloud) instance -- the app works fully
# without this, using the default local regex parser and plain SAR template.
#
# Local development: use the .env file at the project root instead (see
# .env.example) -- python-dotenv picks that up automatically.
#
# Deployed app: copy these lines into your app's "Secrets" panel in the
# Streamlit Community Cloud dashboard (Settings -> Secrets). Do NOT commit a
# real secrets.toml file -- it's gitignored for that reason.
GROQ_API_KEY = "your_groq_api_key_here"
USE_LLM_PARSER = "false"
USE_LLM_SAR_NARRATION = "false"
